# ─── FRONTEND (Vite) ─────────────────────────────────────────────────────────
# Backend API URL — used by the React app for direct API calls.
# In development: leave blank (Vite proxy forwards /api/* to localhost:8080)
# In production:  set to your Cloud Run API URL
VITE_API_URL=

# Gemini API Key — only needed if using Gemini AI features
GEMINI_API_KEY=

# App URL — used for self-referential links
APP_URL=
