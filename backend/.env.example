# ─── SERVER ────────────────────────────────────────────────────────────────────
# Cloud Run injects PORT automatically; locally we default to 8080
PORT=8080
NODE_ENV=development

# Frontend URL — used for OAuth redirect and CORS origin
# Production: the deployed Firebase Hosting URL (e.g. https://worldcup.guesty.com)
FRONTEND_URL="http://localhost:3000"

# ─── FIRESTORE ─────────────────────────────────────────────────────────────────
# GCP project that owns the Firestore database
FIREBASE_PROJECT_ID="ai-innovation-484111"

# Name of the Firestore database to use within the project.
# Leave UNSET to use the project's "(default)" database.
# Set to "worldcup" once the dedicated database is provisioned — this
# keeps our wc_* collections isolated from aiinnovationhubv3.
# FIRESTORE_DATABASE_ID="worldcup"

# Local development only — path to a service account JSON file.
# Do NOT set this in Cloud Run; the runtime uses Application Default
# Credentials from the attached service account.
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In production, store this in Secret Manager and inject via --set-secrets
JWT_SECRET="replace-with-a-very-long-random-secret-at-least-64-chars"
JWT_EXPIRES_IN="24h"

# ─── GOOGLE OAUTH ──────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorised redirect URIs:
#   http://localhost:8080/api/auth/callback                 (dev)
#   https://<your-cloud-run-url>/api/auth/callback          (prod)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8080/api/auth/callback"

# ─── HIBOB ─────────────────────────────────────────────────────────────────────
# Service user with read access to People module
# Create at: https://app.hibob.com → Settings → Integrations → Service Users
HIBOB_SERVICE_USER_ID="your-hibob-service-user-id"
HIBOB_SERVICE_USER_TOKEN="your-hibob-service-user-token"

# ─── FOOTBALL DATA ─────────────────────────────────────────────────────────────
# https://www.football-data.org/  (free tier sufficient for FIFA WC)
FOOTBALL_DATA_API_KEY=""

# ─── ADMIN ACCOUNTS ────────────────────────────────────────────────────────────
# Comma-separated emails granted ADMIN role on first login
ADMIN_EMAILS="yeela@guesty.com,olga.stempin@guesty.com"
